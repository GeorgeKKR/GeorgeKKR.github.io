# Environment Variables Example
# Copy this file to .env.local and uncomment/modify as needed

# ==============================================================================
# SCROLL CONFIGURATION
# ==============================================================================

# Disable smooth scrolling and use native browser scrolling
# Uncomment the line below to disable Lenis smooth scroll
# NEXT_PUBLIC_DISABLE_SMOOTH_SCROLL=true

# ==============================================================================
# EMAIL CONFIGURATION (EmailJS)
# ==============================================================================

# EmailJS Service ID
# Get from: https://dashboard.emailjs.com/admin
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id

# EmailJS Template ID
# Get from: https://dashboard.emailjs.com/admin/templates
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id

# EmailJS Public Key (User ID)
# Get from: https://dashboard.emailjs.com/admin/account
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================

# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Analytics (enabled by default if deployed on Vercel)
# No configuration needed

# ==============================================================================
# DEVELOPMENT
# ==============================================================================

# Disable animations globally (useful for debugging)
# NEXT_PUBLIC_DISABLE_ANIMATIONS=false

# Enable debug mode
# NEXT_PUBLIC_DEBUG=false
